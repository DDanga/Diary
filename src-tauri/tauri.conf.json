{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diary",
  "version": "1.10.1",
  "identifier": "app.diary.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Diary",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Danga",
    "copyright": "© 2026 Danga. MIT License.",
    "category": "Lifestyle",
    "shortDescription": "Offline journaling app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
